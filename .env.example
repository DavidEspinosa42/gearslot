# Copy to .env. Placeholders only.
# Local PGlite socket server (pnpm db:server). Swap for a hosted PostgreSQL URL later.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54320/postgres
DATABASE_POOL_MAX=1

# Locally installed PostgreSQL 18 for the integration tests (required for pnpm test:integration).
# A throwaway database: the tests truncate every table.
DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:5432/gearslot_test

# Identity used in development when no SSO headers are present.
DEV_USER_SUBJECT=dev-user-001
DEV_USER_NAME=Dev User
